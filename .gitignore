.env
.venv/
__pycache__/
*.pyc
.DS_Store

# Streamlit's own secrets file (unused today -- config.toml holds no secrets and is
# committed -- but ignored preemptively so one never lands here by accident).
.streamlit/secrets.toml

# data artifacts (regenerable; keep the tree, drop the contents)
data/raw/*
data/processed/*
data/index/*
data/cache/*
!data/**/.gitkeep

# tooling
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
*.egg-info/
dist/

# Local operating instructions for Claude Code -- not for the public repo
CLAUDE.md
