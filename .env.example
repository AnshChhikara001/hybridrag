# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM provider (Phase 3+). Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional: one-off embedder benchmark only (decision D3, ~$0.009 total)
OPENAI_API_KEY=

# --- Paths (defaults are fine for local development)
HYBRIDRAG_RAW_DIR=data/raw
HYBRIDRAG_PROCESSED_DIR=data/processed
HYBRIDRAG_INDEX_DIR=data/index
# Persistent embedding cache. Regenerable, but deleting it costs a full re-embed.
HYBRIDRAG_CACHE_DIR=data/cache

# --- Chunking
HYBRIDRAG_CHUNK_TOKENS=512
HYBRIDRAG_CHUNK_OVERLAP_TOKENS=64
HYBRIDRAG_SEMANTIC_PERCENTILE=95.0

# --- Indexing
HYBRIDRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HYBRIDRAG_DEDUP_THRESHOLD=0.95

# --- Generation provider. Default (unset) is "gemini" -- free, but capped at 5
# requests/min on the free tier and, measured directly, sometimes 25-30s per call even
# unthrottled. For interactive use (e.g. the Phase 5.2 dashboard, which fires two
# generation calls per question), OpenAI's gpt-5-mini has no artificial pacing and
# measured ~3s per call at roughly $0.001/answer -- see docs/PROJECT_STATE.md.
# HYBRIDRAG_GENERATION_PROVIDER=openai
# HYBRIDRAG_GENERATION_MODEL=gpt-5-mini-2025-08-07
