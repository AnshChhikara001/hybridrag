# Copy to .env and fill in. .env is gitignored and must never be committed.

# --- LLM provider (Phase 3+). Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Optional: one-off embedder benchmark only (decision D3, ~$0.009 total)
OPENAI_API_KEY=

# --- Paths (defaults are fine for local development)
HYBRIDRAG_RAW_DIR=data/raw
HYBRIDRAG_PROCESSED_DIR=data/processed
HYBRIDRAG_INDEX_DIR=data/index
# Persistent embedding cache. Regenerable, but deleting it costs a full re-embed.
HYBRIDRAG_CACHE_DIR=data/cache

# --- Chunking
HYBRIDRAG_CHUNK_TOKENS=512
HYBRIDRAG_CHUNK_OVERLAP_TOKENS=64
HYBRIDRAG_SEMANTIC_PERCENTILE=95.0

# --- Indexing
HYBRIDRAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
HYBRIDRAG_DEDUP_THRESHOLD=0.95
